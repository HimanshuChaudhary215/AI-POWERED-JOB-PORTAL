# Example environment variables for production
# Copy to .env and fill values before deploying

DJANGO_SECRET_KEY=replace-with-a-strong-secret
DEBUG=0
ALLOWED_HOSTS=your-backend.example.com
POSTGRES_DB=job_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
USE_SQLITE=0

# CORS and CSRF
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# Optional: use a single DATABASE_URL instead of POSTGRES_* vars
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: set the frontend URL for client config or ENV
REACT_APP_API_URL=https://your-backend.example.com/api
